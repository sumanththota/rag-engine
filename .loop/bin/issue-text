#!/usr/bin/env python3
"""Issue-body text operations for drive.sh. Body on stdin unless noted.

  issue-text human               text above the sentinel
  issue-text contract            canonical contract after the sentinel (exit 1 if none)
  issue-text hash                sha256 of the contract part (exit 1 if none)
  issue-text blocked-by          issue numbers under `## Blocked by`, one per line
  issue-text extract-contract    canonical contract from planner output (exit 1 if none)
  issue-text compose HUMAN CONTRACT   new issue body: human text, blank line, contract
  issue-text slug TITLE
"""
import sys

import looplib as L


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "slug":
        print(L.slug(argv[2]))
        return 0
    if cmd == "compose":
        human = open(argv[2]).read().rstrip()
        contract = open(argv[3]).read().strip()
        print(human + "\n\n" + contract)
        return 0
    text = sys.stdin.read()
    human, part = L.split_body(text)
    if cmd == "human":
        print(human)
    elif cmd == "contract":
        if part is None or L.extract_contract(part) is None:
            return 1
        print(L.extract_contract(part))
    elif cmd == "hash":
        if part is None:
            return 1
        print(L.contract_hash(part))
    elif cmd == "blocked-by":
        for n in L.blocked_by(human):
            print(n)
    elif cmd == "extract-contract":
        c = L.extract_contract(text)
        if c is None:
            print("no `" + L.SENTINEL + "` followed by a ```yaml block", file=sys.stderr)
            return 1
        print(c)
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
